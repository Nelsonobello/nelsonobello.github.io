# i wanna to fill this: # PostgreSQL (Supabase) connection string — use the "connection pooling" URL for serverless,
# or the direct URL if this runs as a long-lived Node process.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase project (for Storage — private ebook bucket + signed download URLs)
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="xxxxx"   # server-side only — never expose this to any frontend
SUPABASE_EBOOKS_BUCKET="ebooks"

# Paystack (redirect/Standard flow — secret key stays on the backend only)
PAYSTACK_SECRET_KEY="sk_test_xxxxx"
PAYSTACK_CALLBACK_URL="https://yourdomain.com/api/payments/callback"

# Admin auth
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_SESSION_HOURS="12"

# Used by the one-off seed script — NOT stored anywhere after seeding
SEED_ADMIN_EMAIL="nelson@example.com"
SEED_ADMIN_PASSWORD="change-this-before-running-seed"
SEED_ADMIN_NAME="Nelson O. Bello"

PORT=4000